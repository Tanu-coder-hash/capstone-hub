@startuml
left to right direction

actor Student
actor Faculty

rectangle "Idea Bank and Voting System" {
    usecase "View Approved Ideas" as UC1
    usecase "Search and Filter Ideas" as UC2
    usecase "View Idea Details" as UC3
    usecase "Propose New Idea" as UC4
    usecase "Check Similar Ideas" as UC5
    usecase "Upvote Idea" as UC6
    usecase "Withdraw Vote" as UC7
    usecase "View Trending Ideas" as UC8
    usecase "Create and Publish Idea" as UC9
    usecase "View Pending Proposals" as UC10
    usecase "Approve Proposal" as UC11
    usecase "Reject Proposal" as UC12
    usecase "Mark Idea as Taken" as UC13
    usecase "Create Team" as UT1
    usecase "Invite Member" as UT2
    usecase "Respond to Invite" as UT3
    usecase "Leave / Dissolve Team" as UT4
    usecase "Request Ideas" as UT5
    usecase "Approve / Reject Request" as UT6
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC6
Student --> UC7
Student --> UC8
Student --> UT1
Student --> UT2
Student --> UT3
Student --> UT4
Student --> UT5
UC4 .> UC5 : <<include>>

Faculty --> UC1
Faculty --> UC2
Faculty --> UC3
Faculty --> UC8
Faculty --> UC9
Faculty --> UC10
Faculty --> UC11
Faculty --> UC12
Faculty --> UC13
Faculty --> UT6
UT6 ..> UC13 : <<include>>
@enduml